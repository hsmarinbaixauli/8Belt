---
import { withBase } from '../config/site';

// CookieBanner con bloqueo real de cookies no esenciales.
// El mapa de Google (y cualquier otro script no esencial) no se carga
// hasta que el usuario acepte. Dispara el evento global 'cookieConsent'.
---

<!--
  El banner comienza hidden (oculto). El script inline de abajo lo muestra
  inmediatamente si no hay consentimiento previo almacenado, evitando flash.
-->
<aside
  id="cookie-banner"
  hidden
  aria-hidden="true"
  aria-label="Aviso de uso de cookies"
  class="fixed bottom-4 left-4 right-4 sm:left-auto sm:right-5 sm:max-w-md z-[60] bg-surface border border-sand rounded-2xl shadow-xl shadow-black/15 p-5"
>
  <div class="flex items-start gap-3 mb-4">
    <!-- Icono cookie -->
    <div class="shrink-0 w-9 h-9 bg-gold/10 rounded-lg flex items-center justify-center mt-0.5" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8B6914" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/>
        <path d="M8.5 8.5v.01M12 6v.01M17 12v.01M14 16v.01M9.5 15.5v.01"/>
        <path d="M9 9l1 4 3-2 3 4 1-5"/>
      </svg>
    </div>
    <div>
      <h2 class="font-serif text-bark text-[0.9375rem] font-medium leading-snug mb-1">
        Uso de cookies
      </h2>
      <p class="text-earth text-xs leading-relaxed">
        Usamos cookies esenciales para el funcionamiento del sitio. Si aceptas, también cargamos Google Maps para mostrarte nuestra ubicación.
        Puedes leer más en nuestra{' '}
        <a href={withBase('/politica-de-cookies')} class="text-forest underline underline-offset-2 hover:text-forest-dark">
          política de cookies
        </a>.
      </p>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row gap-2">
    <button
      id="cookie-accept"
      type="button"
      class="btn-primary text-sm py-2.5 flex-1 justify-center"
    >
      Aceptar todas
    </button>
    <button
      id="cookie-reject"
      type="button"
      class="btn-secondary text-sm py-2.5 flex-1 justify-center"
    >
      Solo esenciales
    </button>
  </div>

  <p class="mt-3 text-clay text-[0.6875rem] text-center leading-snug">
    Los datos de salud son categoría especial (RGPD). Consulta nuestra{' '}
    <a href={withBase('/politica-de-privacidad')} class="underline underline-offset-1 hover:text-earth">
      política de privacidad
    </a>.
  </p>
</aside>

<!-- Comprobación síncrona: muestra el banner ANTES del primer repintado si no hay consentimiento -->
<script is:inline>
  (function () {
    var stored = localStorage.getItem('beta8_cookies');
    if (!stored) {
      var b = document.getElementById('cookie-banner');
      if (b) {
        b.removeAttribute('hidden');
        b.setAttribute('aria-hidden', 'false');
      }
    }
  })();
</script>

<!-- Lógica de aceptar / rechazar (bundled, corre tras DOM ready con CSS aplicado) -->
<script>
  // Exponer altura real del banner como CSS custom property para que WhatsApp sticky la use
  const initBannerHeight = () => {
    const b = document.getElementById('cookie-banner');
    if (b && !b.hasAttribute('hidden')) {
      document.body.style.setProperty('--cookie-h', b.offsetHeight + 'px');
    }
  };
  initBannerHeight();

  function applyConsent(value: 'accepted' | 'rejected') {
    localStorage.setItem('beta8_cookies', value);

    const banner = document.getElementById('cookie-banner');
    if (banner) {
      // Animación de salida antes de ocultar
      banner.style.transition = 'opacity 250ms ease-out, transform 250ms ease-out';
      banner.style.opacity = '0';
      banner.style.transform = 'translateY(8px)';
      setTimeout(() => {
        banner.setAttribute('hidden', '');
        banner.setAttribute('aria-hidden', 'true');
        banner.style.opacity = '';
        banner.style.transform = '';
        document.body.style.setProperty('--cookie-h', '0px');
      }, 260);
    }

    // Evento global que escuchan el MapEmbed y otros componentes bloqueados
    window.dispatchEvent(
      new CustomEvent('cookieConsent', { detail: { accepted: value === 'accepted' } })
    );
  }

  document.getElementById('cookie-accept')?.addEventListener('click', () => applyConsent('accepted'));
  document.getElementById('cookie-reject')?.addEventListener('click', () => applyConsent('rejected'));
</script>
