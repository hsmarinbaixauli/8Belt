---
// CTA final limpio: lema + botón. Sin precios (van en /servicios y /preguntas-frecuentes).
import { SITE } from '../../config/site';
---

<section aria-labelledby="cta-final-heading" class="bg-forest-dark relative overflow-hidden">

  <!-- Manchas decorativas (aria-hidden) -->
  <div class="pointer-events-none select-none" aria-hidden="true">
    <div class="absolute -top-24 -right-24 w-72 h-72 bg-white/4 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-16 -left-16 w-56 h-56 bg-white/3 rounded-full blur-2xl"></div>
  </div>

  <div class="container-b8 relative">
    <div class="py-20 lg:py-24 flex flex-col items-center text-center gap-8 max-w-2xl mx-auto">

      <!-- Comillas decorativas -->
      <svg
        width="48"
        height="36"
        viewBox="0 0 48 36"
        fill="white"
        fill-opacity="0.12"
        aria-hidden="true"
        class="shrink-0"
      >
        <path d="M0 36V22.286C0 9.952 7.048 2.19 21.143 0l2.571 4.286C16.286 5.905 12.381 9.048 11.143 13.714H20V36H0zm28 0V22.286C28 9.952 35.048 2.19 49.143 0l2.571 4.286C44.286 5.905 40.381 9.048 39.143 13.714H48V36H28z"/>
      </svg>

      <!-- Lema (verbatim del brief §2) -->
      <h2
        id="cta-final-heading"
        class="font-serif italic text-white text-2xl sm:text-3xl lg:text-[2rem] leading-relaxed font-normal"
      >
        {SITE.lema}
      </h2>

      <!-- Separador -->
      <div class="w-12 h-px bg-white/25" aria-hidden="true"></div>

      <!-- Botón único -->
      <a
        href={`https://wa.me/${SITE.phoneRaw}?text=${SITE.whatsappMsg}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-white text-forest-dark font-sans font-semibold text-[0.9375rem] px-8 py-3.5 rounded-full hover:bg-cream transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Pedir cita
      </a>

      <!-- Señal de confianza mínima -->
      <p class="text-white/50 font-sans text-sm">
        Atención con cita previa &middot; Presencial y online
      </p>

    </div>
  </div>
</section>
