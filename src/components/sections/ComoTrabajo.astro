---
// Texto extraído de §5 del brief (verbatim donde se indica)
const pilares = [
  {
    icono: 'shield',
    titulo: 'Terapia Cognitivo-Conductual',
    texto:
      'Mi enfoque parte de la Terapia Cognitivo-Conductual, el modelo psicológico con mayor respaldo científico. Sin embargo, integro técnicas de otros enfoques siempre que aporten un beneficio real a la persona.',
  },
  {
    icono: 'person',
    titulo: 'Intervención individualizada',
    texto:
      'Cada persona es única y la terapia también debe serlo. No existen soluciones universales. Adapto cada proceso a tus necesidades, objetivos y circunstancias, construyendo una intervención hecha para ti.',
  },
  {
    icono: 'book',
    titulo: 'Formación constante',
    texto:
      'La investigación avanza continuamente y considero imprescindible mantener una formación constante para ofrecer intervenciones actualizadas, eficaces y basadas en la mejor evidencia científica disponible.',
  },
  {
    icono: 'chat',
    titulo: 'Trato cercano, claro y humano',
    texto:
      'Procuro que cada sesión combine el rigor científico con un trato cercano, claro y humano. Me gusta explicar el sentido de lo que trabajamos y construir un espacio donde te sientas cómodo para avanzar a tu ritmo.',
  },
] as const;

const iconPaths: Record<string, string> = {
  shield: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>`,
  person: `<circle cx="12" cy="7" r="4"/><path d="M5.5 21a8.38 8.38 0 0 1 13 0"/>`,
  book: `<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>`,
  chat: `<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>`,
};
---

<section aria-labelledby="como-trabajo-heading" class="bg-surface">
  <div class="container-b8 section-py">

    <!-- Encabezado -->
    <div class="text-center max-w-xl mx-auto mb-12">
      <p class="eyebrow mb-4" aria-hidden="true">
        Metodología
      </p>
      <h2 id="como-trabajo-heading" class="font-serif text-bark text-4xl sm:text-5xl font-medium leading-[1.1] mb-6">
        Cómo trabajo
      </h2>
      <span class="rule-accent rule-accent-center mb-6" aria-hidden="true"></span>
      <p class="text-earth text-base sm:text-lg leading-relaxed">
        Cada proceso terapéutico es diferente. Estos son los principios que guían mi forma de acompañarte.
      </p>
    </div>

    <!-- Pilares -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-7">
      {pilares.map((pilar, idx) => (
        <div class="group flex gap-5 p-6 bg-cream rounded-2xl border border-sand hover:border-sage/50 hover:shadow-sm transition-all duration-200">

          <!-- Icono -->
          <div class="shrink-0 w-12 h-12 rounded-xl bg-forest/10 flex items-center justify-center group-hover:bg-forest/18 transition-colors duration-200">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#3F5A45"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={iconPaths[pilar.icono]}
              aria-hidden="true"
            />
          </div>

          <!-- Contenido -->
          <div>
            <h3 class="font-serif text-bark text-[1.0625rem] font-medium mb-2 leading-snug">
              {pilar.titulo}
            </h3>
            <p class="text-earth text-sm leading-relaxed max-w-none">
              {pilar.texto}
            </p>
          </div>

        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-10 text-center">
      <a href="/sobre-la-consulta" class="btn-secondary text-sm">
        Conoce más sobre mi forma de trabajar
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
