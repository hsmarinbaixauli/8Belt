---
import { SITE, withBase } from '../../config/site';

// La frase del centro, con el final destacado ("poder cambiarlo").
const destacado = 'poder cambiarlo';
const corte = SITE.lema.lastIndexOf(destacado);
const fraseInicio = corte > -1 ? SITE.lema.slice(0, corte) : SITE.lema;
const fraseFinal = corte > -1 ? SITE.lema.slice(corte) : '';
---

<section aria-labelledby="hero-heading" class="hero relative bg-cream overflow-hidden">
  <!-- Manchas decorativas de fondo (aria-hidden) -->
  <div class="pointer-events-none select-none" aria-hidden="true">
    <div class="absolute -top-24 -left-24 w-80 h-80 lg:w-[28rem] lg:h-[28rem] bg-sage/12 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 -right-32 w-80 h-80 lg:w-[30rem] lg:h-[30rem] bg-tan/15 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 left-1/3 w-72 h-72 bg-forest/6 rounded-full blur-3xl"></div>
  </div>

  <div class="container-b8 relative py-14 sm:py-20 lg:py-24 flex flex-col items-center text-center">

    <!-- H1: el centro -->
    <h1 id="hero-heading" class="hero-in mb-8 sm:mb-10 flex flex-col items-center">
      <img
        src={withBase('/marca/logo-beta8-principal.png')}
        alt={SITE.name}
        width="900"
        height="646"
        fetchpriority="high"
        decoding="async"
        class="w-56 sm:w-64 lg:w-72 h-auto"
      />
      <span class="block mt-5 eyebrow">Centro de psicología en Valencia</span>
    </h1>

    <!-- La frase del centro, protagonista -->
    <p class="hero-in font-serif text-bark font-medium text-[2.25rem] sm:text-6xl lg:text-7xl xl:text-[5.5rem] leading-[1.06] tracking-tight max-w-5xl text-balance" style="--d: 160ms">
      {fraseInicio}{fraseFinal && (
        <span class="relative inline-block italic text-forest whitespace-nowrap">
          {fraseFinal}
          <svg class="hero-trazo absolute left-0 -bottom-[0.12em] w-full h-[0.28em]" viewBox="0 0 300 24" preserveAspectRatio="none" fill="none" aria-hidden="true">
            <path d="M4 17 C 70 5, 170 3, 296 12" stroke="currentColor" stroke-width="7" stroke-linecap="round" pathLength="1" />
          </svg>
        </span>
      )}
    </p>

    <!-- Presentación del centro -->
    <p class="hero-in mt-10 max-w-2xl text-earth text-lg sm:text-xl leading-relaxed text-balance" style="--d: 260ms">
      Un espacio para sentirte escuchado y acompañado, sin juicios. Atendemos a adultos, niños, adolescentes y familias con una terapia basada en la evidencia y adaptada a cada persona.
    </p>

    <!-- CTAs -->
    <div class="hero-in mt-10 flex flex-col sm:flex-row justify-center gap-3 w-full sm:w-auto" style="--d: 340ms">
          <a
            href={`https://wa.me/${SITE.phoneRaw}?text=${SITE.whatsappMsg}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-[0.9375rem] py-3.5 px-7"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Pedir cita
          </a>
          <a href={withBase('/servicios')} class="btn-secondary text-[0.9375rem] py-3.5 px-7">
            Ver servicios
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
    </div>

    <!-- Señal de confianza -->
    <p class="hero-in mt-6 font-sans text-clay text-sm" style="--d: 400ms">
      Atención con cita previa &middot; {SITE.credential} colegiado nº {SITE.colegiadoNum}
    </p>
  </div>
</section>

<style>
  .hero-trazo {
    color: var(--color-tan);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      opacity: 0;
      transform: translateY(14px);
      animation: hero-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      animation-delay: var(--d, 0ms);
    }

    .hero-trazo path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: hero-trazo 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.75s forwards;
    }
  }

  @keyframes hero-in {
    to { opacity: 1; transform: none; }
  }

  @keyframes hero-trazo {
    to { stroke-dashoffset: 0; }
  }
</style>
