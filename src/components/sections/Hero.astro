---
import { SITE } from '../../config/site';
---

<section aria-labelledby="hero-heading" class="relative bg-cream overflow-hidden">
  <!-- Manchas decorativas de fondo (aria-hidden) -->
  <div class="pointer-events-none select-none" aria-hidden="true">
    <div class="absolute top-1/4 right-0 w-72 h-72 lg:w-96 lg:h-96 bg-sage/8 rounded-full blur-3xl translate-x-1/2"></div>
    <div class="absolute bottom-0 left-1/4 w-56 h-56 bg-forest/5 rounded-full blur-2xl translate-y-1/3"></div>
  </div>

  <div class="container-b8 section-py relative">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">

      <!-- Columna texto -->
      <div class="lg:col-span-7 flex flex-col justify-center">

        <!-- Badge de ubicación/modalidad -->
        <div class="inline-flex items-center gap-2 self-start bg-forest/8 text-forest border border-forest/20 rounded-full px-4 py-1.5 text-sm font-sans font-semibold mb-6" aria-label="Valencia · Atención presencial y online">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Valencia &middot; Presencial y online
        </div>

        <!-- H1 -->
        <h1 id="hero-heading" class="font-serif text-bark font-medium text-4xl sm:text-5xl lg:text-[3.125rem] xl:text-[3.375rem] leading-[1.12] tracking-tight mb-3">
          Psicólogo General Sanitario en Valencia
        </h1>

        <!-- Nombre -->
        <p class="font-sans text-earth font-medium text-lg mb-6">
          {SITE.psychologist}
        </p>

        <!-- Lema (texto del brief, verbatim) -->
        <blockquote class="border-l-[3px] border-forest pl-5 mb-8" cite="#">
          <p class="font-serif italic text-forest text-xl leading-relaxed">
            &ldquo;{SITE.lema}&rdquo;
          </p>
        </blockquote>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-3 mb-5">
          <a
            href={`https://wa.me/${SITE.phoneRaw}?text=${SITE.whatsappMsg}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-[0.9375rem] py-3.5 px-7"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Pedir cita
          </a>
          <a href="/servicios" class="btn-secondary text-[0.9375rem] py-3.5 px-7">
            Ver servicios
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Señal de confianza -->
        <p class="font-sans text-clay text-sm">
          Atención con cita previa &middot; Presencial y online
        </p>
      </div>

      <!-- Columna foto -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-full max-w-[340px] sm:max-w-[380px] lg:max-w-none">

          <!-- Blob decorativo detrás de la foto -->
          <div
            class="absolute -top-6 -right-6 -bottom-6 -left-6 bg-sage/10 rounded-[40%_60%_55%_45%/45%_55%_60%_40%] -z-10"
            aria-hidden="true"
          ></div>

          <!-- Placeholder foto -->
          <!-- [PENDIENTE: sustituir por img real con src="/fotos/santiago-navarro.jpg" alt="Santiago Navarro Zamora, Psicólogo General Sanitario en Valencia"] -->
          <div
            class="aspect-[3/4] w-full rounded-3xl bg-sage/12 border-2 border-dashed border-sage/30 flex flex-col items-center justify-center gap-4 p-8"
            role="img"
            aria-label="[PENDIENTE: Retrato de Santiago Navarro Zamora]"
          >
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#8C9C7C" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="7" r="4.5"/>
              <path d="M2.5 21.5a9.5 9.5 0 0 1 19 0"/>
            </svg>
            <div class="text-center">
              <span class="badge-pending mb-2">Imagen pendiente</span>
              <p class="text-clay text-sm font-sans mt-2 leading-snug">
                Retrato de<br/><strong class="text-earth font-medium">Santiago Navarro Zamora</strong>
              </p>
            </div>
          </div>

          <!-- Tarjeta flotante: próxima apertura -->
          <div class="absolute -bottom-4 -left-4 bg-surface border border-sand rounded-2xl shadow-md shadow-black/8 px-4 py-3 flex items-center gap-3 max-w-[200px]">
            <div class="w-8 h-8 bg-forest/10 rounded-full flex items-center justify-center shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#3F5A45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </div>
            <div class="leading-tight">
              <p class="font-sans text-xs font-semibold text-bark">Apertura</p>
              <p class="font-sans text-[0.65rem] text-clay">~Septiembre 2026</p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Separador visual sutil -->
  <div class="h-px bg-sand/60 mx-8 lg:mx-16" aria-hidden="true"></div>
</section>
