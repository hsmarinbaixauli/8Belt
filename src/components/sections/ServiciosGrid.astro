---
import { SITE, SERVICIOS, withBase } from '../../config/site';

// SVG paths por icono de servicio (estilo Lucide, stroke="currentColor", stroke-width="1.5")
const iconPaths: Record<string, string> = {
  person: `<circle cx="12" cy="7" r="4"/><path d="M5.5 21a8.38 8.38 0 0 1 13 0"/>`,
  child: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  video: `<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>`,
  brain: `<path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/>`,
  family: `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`,
  home: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
};
---

<section aria-labelledby="servicios-heading" class="bg-cream">
  <div class="container-b8 section-py">

    <!-- Encabezado -->
    <div class="text-center max-w-xl mx-auto mb-12">
      <p class="eyebrow mb-4" aria-hidden="true">
        Servicios
      </p>
      <h2 id="servicios-heading" class="font-serif text-bark text-4xl sm:text-5xl font-medium leading-[1.1] mb-6">
        Cómo puedo ayudarte
      </h2>
      <span class="rule-accent rule-accent-center mb-6" aria-hidden="true"></span>
      <p class="text-earth text-base sm:text-lg leading-relaxed">
        Ofrezco atención psicológica especializada en diferentes modalidades, siempre adaptada a tu situación y necesidades.
      </p>
    </div>

    <!-- Grid de servicios -->
    <ul
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6"
      role="list"
    >
      {SERVICIOS.map((servicio) => (
        <li>
          <a
            href={withBase(`/servicios/${servicio.slug}`)}
            class="group flex flex-col h-full bg-surface border border-sand rounded-2xl p-6 hover:border-forest/40 hover:shadow-md hover:shadow-forest/8 hover:-translate-y-0.5 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-forest focus-visible:ring-offset-2 focus-visible:outline-none"
            aria-label={`${servicio.titulo}: ${servicio.descripcionBreve}`}
          >
            <!-- Icono -->
            <div class="w-12 h-12 rounded-xl bg-forest/10 flex items-center justify-center mb-4 group-hover:bg-forest/18 transition-colors duration-200 shrink-0">
              <svg
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#3F5A45"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={iconPaths[servicio.icono]}
                aria-hidden="true"
              />
            </div>

            <!-- Título -->
            <h3 class="font-serif text-bark text-lg font-medium leading-snug mb-2 group-hover:text-forest transition-colors duration-200">
              {servicio.titulo}
            </h3>

            <!-- Subtítulo -->
            <p class="text-clay text-xs font-sans font-medium italic mb-3">
              {servicio.subtitulo}
            </p>

            <!-- Descripción -->
            <p class="text-earth text-sm leading-relaxed flex-1">
              {servicio.descripcionBreve}
            </p>

            <!-- Enlace -->
            <div class="mt-4 flex items-center gap-1.5 text-forest text-sm font-sans font-semibold group-hover:gap-2.5 transition-all duration-200">
              <span>Ver servicio</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA recurrente #2 -->
    <div class="mt-12 text-center">
      <p class="text-earth text-base font-sans mb-4">
        ¿Tienes dudas sobre qué servicio se adapta mejor a tu situación?
      </p>
      <a
        href={`https://wa.me/${SITE.phoneRaw}?text=${SITE.whatsappMsg}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Escríbeme y lo vemos juntos
      </a>
    </div>

  </div>
</section>
