---
import { SITE, withBase } from '../config/site';

const navLinks = [
  { href: withBase('/servicios'), label: 'Servicios' },
  { href: withBase('/sobre-la-consulta'), label: 'Sobre la consulta' },
  { href: withBase('/preguntas-frecuentes'), label: 'FAQ' },
  { href: withBase('/contacto'), label: 'Contacto' },
];

const currentPath = Astro.url.pathname;
---

<!-- Header sólido: fondo crema siempre → contraste AA garantizado sin necesidad de scrim -->
<header class="sticky top-0 z-40 bg-cream border-b border-sand" role="banner">
  <div class="container-b8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href={withBase('/')} aria-label={`${SITE.name} — página de inicio`} class="flex items-center gap-3 shrink-0">
        <!-- [PENDIENTE: sustituir por logo vectorial/alta resolución cuando esté disponible] -->
        <div
          class="w-9 h-9 bg-forest rounded-xl flex items-center justify-center shrink-0"
          aria-hidden="true"
        >
          <span class="text-white font-serif text-sm font-bold leading-none select-none">B8</span>
        </div>
        <div class="leading-tight">
          <div class="font-serif font-medium text-bark text-[0.9375rem] leading-snug">Beta 8 Center</div>
          <div class="font-sans text-clay text-[0.6875rem] font-medium">Psicología · Valencia</div>
        </div>
      </a>

      <!-- Navegación desktop -->
      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-7">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={[
              'font-sans text-sm font-medium transition-colors duration-150 relative group',
              currentPath.startsWith(href)
                ? 'text-forest'
                : 'text-earth hover:text-forest',
            ].join(' ')}
            aria-current={currentPath.startsWith(href) ? 'page' : undefined}
          >
            {label}
            <!-- Underline indicador activo -->
            <span
              class={[
                'absolute -bottom-1 left-0 h-0.5 bg-forest rounded-full transition-all duration-200',
                currentPath.startsWith(href) ? 'w-full' : 'w-0 group-hover:w-full',
              ].join(' ')}
              aria-hidden="true"
            />
          </a>
        ))}
      </nav>

      <!-- CTA desktop -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href={`https://wa.me/${SITE.phoneRaw}?text=${SITE.whatsappMsg}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-sm py-2.5 px-5"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Pedir cita
        </a>
      </div>

      <!-- Botón hamburger (mobile) -->
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        class="lg:hidden flex items-center justify-center w-10 h-10 rounded-lg text-bark hover:bg-sand/50 transition-colors"
      >
        <!-- Icono hamburger -->
        <svg id="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
        <!-- Icono cerrar (oculto por defecto) -->
        <svg id="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

    </div>
  </div>
</header>

<!-- Menú mobile (panel full-screen) -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  aria-hidden="true"
  inert
  class="fixed inset-0 z-50 bg-cream flex flex-col translate-x-full transition-transform duration-300 ease-out lg:hidden"
>
  <!-- Cabecera del panel mobile -->
  <div class="flex items-center justify-between h-16 px-5 border-b border-sand shrink-0">
    <a href={withBase('/')} aria-label={`${SITE.name} — inicio`} class="flex items-center gap-3">
      <div class="w-9 h-9 bg-forest rounded-xl flex items-center justify-center" aria-hidden="true">
        <span class="text-white font-serif text-sm font-bold leading-none select-none">B8</span>
      </div>
      <span class="font-serif font-medium text-bark text-[0.9375rem]">Beta 8 Center</span>
    </a>
    <button
      id="menu-close"
      type="button"
      aria-label="Cerrar menú"
      class="flex items-center justify-center w-10 h-10 rounded-lg text-bark hover:bg-sand/50 transition-colors"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Links del menú -->
  <nav aria-label="Menú móvil" class="flex-1 flex flex-col justify-center px-8 gap-2">
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class="font-serif text-2xl font-medium text-bark py-3 border-b border-sand/60 hover:text-forest transition-colors duration-150"
        aria-current={currentPath.startsWith(href) ? 'page' : undefined}
      >
        {label}
      </a>
    ))}
  </nav>

  <!-- CTA en pie del menú -->
  <div class="px-8 pb-10 shrink-0">
    <a
      href={`https://wa.me/${SITE.phoneRaw}?text=${SITE.whatsappMsg}`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary w-full justify-center text-base"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
      Pedir cita por WhatsApp
    </a>
    <p class="text-center text-clay text-xs font-sans mt-4">Atención con cita previa</p>
  </div>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const closeBtn = document.getElementById('menu-close');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  function openMenu() {
    menu?.classList.remove('translate-x-full');
    menu?.removeAttribute('inert');
    menu?.setAttribute('aria-hidden', 'false');
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Cerrar menú de navegación');
    iconMenu?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    closeBtn?.focus();
  }

  function closeMenu() {
    menu?.classList.add('translate-x-full');
    menu?.setAttribute('inert', '');
    menu?.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Abrir menú de navegación');
    iconMenu?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    document.body.style.overflow = '';
    toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);

  // Cerrar con Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });

  // Cerrar al navegar a otra página
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
