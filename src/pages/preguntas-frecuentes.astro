---
import Layout from '../layouts/Layout.astro';
import CTAFinal from '../components/sections/CTAFinal.astro';
import { SITE } from '../config/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cuánto dura una sesión?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Las sesiones individuales suelen tener una duración aproximada de entre 50 y 60 minutos, aunque en determinados casos esta duración puede variar ligeramente en función de las necesidades de la intervención o de la técnica terapéutica utilizada.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Con qué frecuencia tendré que acudir a terapia?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Al inicio del proceso, suele recomendarse una frecuencia semanal, ya que permite establecer una buena base de trabajo y avanzar de forma constante. Posteriormente, y en función de la evolución y los objetivos terapéuticos, las sesiones pueden espaciarse a una frecuencia quincenal o mensual.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cuánto tiempo suele durar un proceso terapéutico?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No existe una duración exacta, ya que depende de múltiples factores, como la situación personal, los objetivos planteados, la motivación y el ritmo de cada persona. En algunos casos, unos pocos meses pueden ser suficientes; en otros puede ser necesario un acompañamiento más prolongado, especialmente cuando se trabajan dificultades de larga evolución.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué puedo esperar de la primera sesión?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Estará orientada a conocernos y comprender tu situación actual. Hablaremos sobre qué está ocurriendo, cómo lo estás viviendo y cuáles son tus necesidades y objetivos. Este primer encuentro nos permitirá empezar a construir una comprensión compartida y establecer las bases del trabajo.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué ocurre si no puedo acudir a una sesión?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pueden surgir imprevistos. Si no puedes acudir, podrás cancelarla o modificarla sin problema siempre que avises con al menos 24 horas de antelación. En caso de no comunicar la cancelación dentro de ese plazo, la sesión se considerará realizada y deberá abonarse igualmente.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cuál es el precio de las sesiones y cómo se realiza el pago?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Las sesiones tienen un coste de 55 € (terapia familiar, 65 €). El pago puede realizarse mediante Bizum, transferencia bancaria o efectivo (en modalidad presencial).',
      },
    },
  ],
};

const faqs = [
  {
    pregunta: '¿Cuánto dura una sesión?',
    respuesta: 'Las sesiones individuales suelen tener una duración aproximada de entre 50 y 60 minutos, aunque en determinados casos esta duración puede variar ligeramente en función de las necesidades de la intervención o de la técnica terapéutica utilizada.',
  },
  {
    pregunta: '¿Con qué frecuencia tendré que acudir a terapia?',
    respuesta: 'Al inicio del proceso, suele recomendarse una frecuencia semanal, ya que permite establecer una buena base de trabajo y avanzar de forma constante. Posteriormente, y en función de la evolución y los objetivos terapéuticos, las sesiones pueden espaciarse a una frecuencia quincenal o mensual.',
  },
  {
    pregunta: '¿Cuánto tiempo suele durar un proceso terapéutico?',
    respuesta: 'No existe una duración exacta, ya que depende de múltiples factores, como la situación personal, los objetivos planteados, la motivación y el ritmo de cada persona. En algunos casos, unos pocos meses pueden ser suficientes; en otros puede ser necesario un acompañamiento más prolongado, especialmente cuando se trabajan dificultades de larga evolución. Lo importante es que el proceso se adapte siempre a las necesidades individuales de cada persona.',
  },
  {
    pregunta: '¿Qué puedo esperar de la primera sesión?',
    respuesta: 'Estará orientada a conocernos y comprender tu situación actual. Hablaremos sobre qué está ocurriendo, cómo lo estás viviendo y cuáles son tus necesidades y objetivos. Este primer encuentro nos permitirá empezar a construir una comprensión compartida y establecer las bases del trabajo. El malestar no suele resolverse en una o dos sesiones; la terapia es un proceso que requiere tiempo, constancia y compromiso.',
  },
  {
    pregunta: '¿Qué ocurre si no puedo acudir a una sesión?',
    respuesta: 'Pueden surgir imprevistos. Si no puedes acudir, podrás cancelarla o modificarla sin problema siempre que avises con al menos 24 horas de antelación. En caso de no comunicar la cancelación dentro de ese plazo, la sesión se considerará realizada y deberá abonarse igualmente.',
  },
  {
    pregunta: '¿Cuál es el precio de las sesiones y cómo se realiza el pago?',
    respuesta: `Las sesiones tienen un coste de ${SITE.priceSesion} € (terapia familiar, ${SITE.priceFamiliar} €). El pago puede realizarse mediante Bizum, transferencia bancaria o efectivo (en modalidad presencial).`,
  },
];
---

<Layout
  title="Preguntas frecuentes"
  description={`Resuelve tus dudas sobre la terapia psicológica en ${SITE.name}. Preguntas frecuentes sobre duración, frecuencia, primera sesión y precios.`}
  schema={schema}
>

  <!-- ── Cabecera ── -->
  <section aria-labelledby="faq-heading" class="bg-surface border-b border-sand/60">
    <div class="container-b8 py-14 lg:py-20">
      <div class="max-w-2xl">
        <nav aria-label="Ruta de navegación" class="mb-6">
          <ol class="flex items-center gap-2 text-sm font-sans text-clay">
            <li><a href="/" class="inline-block py-1 hover:text-forest transition-colors">Inicio</a></li>
            <li aria-hidden="true" class="text-sand">›</li>
            <li class="text-earth font-medium" aria-current="page">Preguntas frecuentes</li>
          </ol>
        </nav>
        <p class="eyebrow mb-4" aria-hidden="true">
          Dudas habituales
        </p>
        <h1 id="faq-heading" class="font-serif text-bark text-4xl sm:text-5xl font-medium leading-tight mb-5">
          Preguntas frecuentes
        </h1>
        <p class="text-earth text-lg leading-relaxed">
          Aquí encontrarás algunas de las dudas más habituales que suelen surgir antes de iniciar un proceso terapéutico. Si tu pregunta no aparece en este listado, no dudes en ponerte en contacto conmigo. Estaré encantado de ayudarte.
        </p>
      </div>
    </div>
  </section>

  <!-- ── FAQ Accordion ── -->
  <section aria-label="Lista de preguntas frecuentes" class="bg-cream">
    <div class="container-b8 section-py">
      <div class="max-w-2xl mx-auto">
        <ul class="space-y-3" role="list">
          {faqs.map((faq, idx) => (
            <li>
              <details
                class="group bg-surface border border-sand rounded-2xl overflow-hidden hover:border-sage/40 transition-colors duration-200"
                id={`faq-${idx}`}
              >
                <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none select-none focus-visible:outline-2 focus-visible:outline-forest focus-visible:outline-offset-2">
                  <h3 class="font-serif text-bark font-medium text-base leading-snug">
                    {faq.pregunta}
                  </h3>
                  <span class="shrink-0 w-6 h-6 rounded-full bg-forest/10 flex items-center justify-center group-open:bg-forest/18 transition-colors duration-200" aria-hidden="true">
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="text-forest transition-transform duration-200 group-open:rotate-180"
                    >
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </span>
                </summary>
                <div class="px-6 pb-5 pt-0">
                  <p class="text-earth text-base leading-relaxed border-t border-sand/60 pt-4">
                    {faq.respuesta}
                  </p>
                </div>
              </details>
            </li>
          ))}
        </ul>

        <!-- Contacto adicional -->
        <div class="mt-10 p-6 bg-surface border border-sand rounded-2xl text-center">
          <p class="font-serif text-bark font-medium text-lg mb-2">¿Tienes otra pregunta?</p>
          <p class="text-earth text-sm leading-relaxed mb-5">
            Si no encuentras la respuesta que buscas, puedes escribirme directamente y te respondo lo antes posible.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a
              href={`https://wa.me/${SITE.phoneRaw}?text=${SITE.whatsappMsg}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary text-sm"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Escribirme por WhatsApp
            </a>
            <a href="/contacto" class="btn-secondary text-sm">
              Ver todos los contactos
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA final ── -->
  <CTAFinal />

</Layout>
