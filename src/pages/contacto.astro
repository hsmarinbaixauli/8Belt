---
import Layout from '../layouts/Layout.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { SITE } from '../config/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': ['Psychologist', 'LocalBusiness'],
  name: SITE.name,
  url: `${SITE.url}/contacto`,
  telephone: SITE.phoneRaw,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address,
    addressLocality: SITE.city,
    addressCountry: 'ES',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer service',
      telephone: SITE.phoneRaw,
      email: SITE.email,
      availableLanguage: 'Spanish',
    },
  ],
};

const canales = [
  {
    icono: 'whatsapp',
    titulo: 'WhatsApp',
    descripcion: 'La forma más rápida de contactar. Te respondo lo antes posible.',
    enlace: `https://wa.me/${SITE.phoneRaw}?text=${SITE.whatsappMsg}`,
    etiqueta: 'Escribir por WhatsApp',
    externo: true,
  },
  {
    icono: 'phone',
    titulo: 'Teléfono',
    descripcion: SITE.phone,
    enlace: `tel:${SITE.phoneRaw}`,
    etiqueta: `Llamar al ${SITE.phone}`,
    externo: false,
  },
  {
    icono: 'email',
    titulo: 'Email',
    descripcion: SITE.email,
    enlace: `mailto:${SITE.email}`,
    etiqueta: `Enviar email a ${SITE.email}`,
    externo: false,
  },
];

const iconos: Record<string, string> = {
  whatsapp: `<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>`,
  phone: `<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.85 9.8a19.79 19.79 0 01-3.07-8.67A2 2 0 012.8 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.89 7.78a16 16 0 006.29 6.29l1.14-1.14a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>`,
  email: `<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>`,
};
---

<Layout
  title="Contacto y cita previa"
  description={`Contacta con ${SITE.name} para pedir cita con ${SITE.psychologist}. WhatsApp, teléfono y email. Atención presencial en Valencia y online.`}
  schema={schema}
>

  <!-- ── Cabecera ── -->
  <section aria-labelledby="contacto-heading" class="bg-surface border-b border-sand/60">
    <div class="container-b8 py-14 lg:py-20">
      <div class="max-w-2xl">
        <nav aria-label="Ruta de navegación" class="mb-6">
          <ol class="flex items-center gap-2 text-sm font-sans text-clay">
            <li><a href="/" class="inline-block py-1 hover:text-forest transition-colors">Inicio</a></li>
            <li aria-hidden="true" class="text-sand">›</li>
            <li class="text-earth font-medium" aria-current="page">Contacto</li>
          </ol>
        </nav>
        <p class="eyebrow mb-4" aria-hidden="true">
          Cita previa
        </p>
        <h1 id="contacto-heading" class="font-serif text-bark text-4xl sm:text-5xl font-medium leading-tight mb-5">
          Hablemos
        </h1>
        <p class="text-earth text-lg leading-relaxed">
          Puedes contactarme por WhatsApp, teléfono o email. Atiendo con cita previa, tanto en consulta presencial en Valencia como de forma online.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Canales de contacto + Formulario ── -->
  <section aria-label="Formas de contacto y formulario" class="bg-cream">
    <div class="container-b8 section-py">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">

        <!-- Columna izquierda: canales + dirección -->
        <div>
          <h2 class="font-serif text-bark text-2xl font-medium leading-tight mb-7">
            Canales de contacto
          </h2>

          <ul class="space-y-4 mb-10" role="list">
            {canales.map((canal) => (
              <li>
                <a
                  href={canal.enlace}
                  {...canal.externo ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
                  class="group flex items-start gap-4 p-5 bg-surface border border-sand rounded-2xl hover:border-forest/40 hover:shadow-sm transition-all duration-200 focus-visible:ring-2 focus-visible:ring-forest focus-visible:ring-offset-2 focus-visible:outline-none"
                  aria-label={canal.etiqueta}
                >
                  <div class="shrink-0 w-11 h-11 rounded-xl bg-forest/10 flex items-center justify-center group-hover:bg-forest/18 transition-colors duration-200" aria-hidden="true">
                    <svg
                      width="20"
                      height="20"
                      viewBox="0 0 24 24"
                      fill={canal.icono === 'whatsapp' ? '#3F5A45' : 'none'}
                      stroke={canal.icono === 'whatsapp' ? 'none' : '#3F5A45'}
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={iconos[canal.icono]}
                      aria-hidden="true"
                    />
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-serif text-bark font-medium text-base leading-snug mb-0.5">
                      {canal.titulo}
                    </p>
                    <p class="text-earth text-sm leading-snug break-words">
                      {canal.descripcion}
                    </p>
                  </div>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8C9C7C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 mt-0.5">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>

          <!-- Dirección -->
          <div class="p-5 bg-surface border border-sand rounded-2xl">
            <h3 class="font-serif text-bark font-medium text-base mb-3 flex items-center gap-2">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3F5A45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              Ubicación
            </h3>
            <address class="not-italic text-earth text-sm leading-relaxed">
              <strong class="text-bark">{SITE.addressFull}</strong>
              <br />
              <em class="text-clay text-xs not-italic mt-1 block">{SITE.addressNote}</em>
            </address>
            <p class="mt-3 text-clay text-xs font-sans">
              Atención solo con cita previa · No hay horario fijo publicado hasta la apertura del centro.
            </p>
          </div>
        </div>

        <!-- Columna derecha: formulario -->
        <div>
          <h2 class="font-serif text-bark text-2xl font-medium leading-tight mb-2">
            Envíame un mensaje
          </h2>
          <p class="text-clay text-sm font-sans leading-relaxed mb-7">
            Rellena el formulario y te contactaré lo antes posible.
          </p>

          <!-- TODO: conectar formulario a backend / servicio de email -->
          <div id="form-todo-notice" class="mb-5 p-3 bg-amber-50 border border-amber-200 rounded-xl" role="alert">
            <p class="text-amber-800 text-xs font-sans leading-relaxed">
              <span class="badge-pending mr-1">TODO</span>
              Formulario pendiente de conexión a backend o servicio de email (Resend, Formspree, etc.). Por ahora el envío está deshabilitado.
            </p>
          </div>

          <form
            id="contacto-form"
            class="space-y-5"
            novalidate
            aria-label="Formulario de contacto"
          >
            <!-- Nombre -->
            <div>
              <label for="nombre" class="block font-sans text-bark text-sm font-semibold mb-1.5">
                Nombre <span class="text-danger" aria-hidden="true">*</span>
                <span class="sr-only">(requerido)</span>
              </label>
              <input
                type="text"
                id="nombre"
                name="nombre"
                autocomplete="given-name"
                required
                class="w-full px-4 py-3 bg-surface border border-sand rounded-xl font-sans text-earth text-sm placeholder:text-clay/60 focus:outline-none focus:border-forest focus:ring-2 focus:ring-forest/20 transition-colors"
                placeholder="Tu nombre"
              />
            </div>

            <!-- Email -->
            <div>
              <label for="email" class="block font-sans text-bark text-sm font-semibold mb-1.5">
                Email <span class="text-danger" aria-hidden="true">*</span>
                <span class="sr-only">(requerido)</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                class="w-full px-4 py-3 bg-surface border border-sand rounded-xl font-sans text-earth text-sm placeholder:text-clay/60 focus:outline-none focus:border-forest focus:ring-2 focus:ring-forest/20 transition-colors"
                placeholder="tu@email.com"
              />
            </div>

            <!-- Teléfono -->
            <div>
              <label for="telefono" class="block font-sans text-bark text-sm font-semibold mb-1.5">
                Teléfono <span class="text-clay text-xs font-normal">(opcional)</span>
              </label>
              <input
                type="tel"
                id="telefono"
                name="telefono"
                autocomplete="tel"
                class="w-full px-4 py-3 bg-surface border border-sand rounded-xl font-sans text-earth text-sm placeholder:text-clay/60 focus:outline-none focus:border-forest focus:ring-2 focus:ring-forest/20 transition-colors"
                placeholder="+34 600 000 000"
              />
            </div>

            <!-- Mensaje -->
            <div>
              <label for="mensaje" class="block font-sans text-bark text-sm font-semibold mb-1.5">
                Mensaje <span class="text-danger" aria-hidden="true">*</span>
                <span class="sr-only">(requerido)</span>
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                class="w-full px-4 py-3 bg-surface border border-sand rounded-xl font-sans text-earth text-sm placeholder:text-clay/60 focus:outline-none focus:border-forest focus:ring-2 focus:ring-forest/20 transition-colors resize-none"
                placeholder="Cuéntame brevemente qué te trae por aquí o qué preguntas tienes..."
              ></textarea>
            </div>

            <!-- RGPD -->
            <div>
              <div class="flex items-start gap-3">
                <input
                  type="checkbox"
                  id="rgpd"
                  name="rgpd"
                  required
                  class="mt-0.5 w-4 h-4 shrink-0 rounded border border-sand accent-forest focus:ring-2 focus:ring-forest/30"
                />
                <label for="rgpd" class="font-sans text-earth text-sm leading-relaxed">
                  He leído y acepto la{' '}
                  <a href="/politica-de-privacidad" class="text-forest hover:text-forest-dark underline underline-offset-2">
                    política de privacidad
                  </a>
                  . Consiento el tratamiento de mis datos personales para gestionar mi consulta.
                  <span class="text-danger" aria-hidden="true"> *</span>
                  <span class="sr-only">(requerido)</span>
                </label>
              </div>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="btn-primary w-full justify-center"
              aria-describedby="form-todo-notice"
            >
              Enviar mensaje
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>

          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Mapa ── -->
  <section aria-labelledby="mapa-heading" class="bg-surface">
    <div class="container-b8 section-py">
      <div class="max-w-3xl mx-auto">
        <h2 id="mapa-heading" class="font-serif text-bark text-2xl sm:text-3xl font-medium leading-tight mb-2">
          Dónde estamos
        </h2>
        <p class="text-clay text-sm font-sans mb-6">
          {SITE.addressFull}<br />
          <em class="text-clay/80 text-xs">{SITE.addressNote}</em>
        </p>
        <MapEmbed />
      </div>
    </div>
  </section>

</Layout>

<script>
  const form = document.getElementById('contacto-form') as HTMLFormElement | null;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // TODO: conectar con backend / Resend / Formspree
    const notice = document.getElementById('form-todo-notice');
    if (notice) {
      notice.innerHTML = `<p class="text-amber-800 text-xs font-sans leading-relaxed font-semibold">
        ⚠️ El envío no está configurado aún. Por favor, contacta directamente por WhatsApp o email.
      </p>`;
    }
  });
</script>
