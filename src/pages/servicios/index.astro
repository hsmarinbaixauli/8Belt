---
import Layout from '../../layouts/Layout.astro';
import CTAFinal from '../../components/sections/CTAFinal.astro';
import { SITE, SERVICIOS } from '../../config/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de psicología — Beta 8 Center',
  url: `${SITE.url}/servicios`,
  itemListElement: SERVICIOS.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.titulo,
      url: `${SITE.url}/servicios/${s.slug}`,
      description: s.descripcionBreve,
      provider: {
        '@type': 'LocalBusiness',
        name: SITE.name,
      },
    },
  })),
};

const iconPaths: Record<string, string> = {
  person: `<circle cx="12" cy="7" r="4"/><path d="M5.5 21a8.38 8.38 0 0 1 13 0"/>`,
  child: `<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  video: `<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/>`,
  brain: `<path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/>`,
  family: `<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`,
  home: `<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>`,
};
---

<Layout
  title="Servicios de psicología"
  description={`Servicios psicológicos en Valencia: terapia individual, infanto-juvenil, online, neurodivergencia, orientación familiar y terapia familiar. ${SITE.psychologist}, ${SITE.credential}.`}
  schema={schema}
>

  <!-- ── Cabecera de página ── -->
  <section aria-labelledby="servicios-page-heading" class="bg-surface border-b border-sand/60">
    <div class="container-b8 py-14 lg:py-20">
      <div class="max-w-2xl">
        <nav aria-label="Ruta de navegación" class="mb-6">
          <ol class="flex items-center gap-2 text-sm font-sans text-clay">
            <li><a href="/" class="inline-block py-1 hover:text-forest transition-colors">Inicio</a></li>
            <li aria-hidden="true" class="text-sand">›</li>
            <li class="text-earth font-medium" aria-current="page">Servicios</li>
          </ol>
        </nav>
        <p class="eyebrow mb-4" aria-hidden="true">
          Atención psicológica
        </p>
        <h1 id="servicios-page-heading" class="font-serif text-bark text-4xl sm:text-5xl font-medium leading-tight mb-5">
          Cómo puedo ayudarte
        </h1>
        <p class="text-earth text-lg leading-relaxed max-w-xl">
          Ofrezco atención psicológica especializada en diferentes modalidades, siempre adaptada a tu situación y necesidades concretas.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Grid de servicios ── -->
  <section aria-label="Lista de servicios" class="bg-cream">
    <div class="container-b8 section-py">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6" role="list">
        {SERVICIOS.map((servicio) => (
          <li>
            <a
              href={`/servicios/${servicio.slug}`}
              class="group flex flex-col h-full bg-surface border border-sand rounded-2xl p-6 hover:border-forest/40 hover:shadow-md hover:shadow-forest/8 hover:-translate-y-0.5 transition-all duration-200 focus-visible:ring-2 focus-visible:ring-forest focus-visible:ring-offset-2 focus-visible:outline-none"
            >
              <div class="w-12 h-12 rounded-xl bg-forest/10 flex items-center justify-center mb-4 group-hover:bg-forest/18 transition-colors duration-200 shrink-0" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#3F5A45"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={iconPaths[servicio.icono]}
                  aria-hidden="true"
                />
              </div>
              <h2 class="font-serif text-bark text-lg font-medium leading-snug mb-2 group-hover:text-forest transition-colors duration-200">
                {servicio.titulo}
              </h2>
              <p class="text-clay text-xs font-sans font-medium italic mb-3">
                {servicio.subtitulo}
              </p>
              <p class="text-earth text-sm leading-relaxed flex-1">
                {servicio.descripcionBreve}
              </p>
              <div class="mt-5 flex items-center gap-1.5 text-forest text-sm font-sans font-semibold group-hover:gap-2.5 transition-all duration-200">
                <span>Ver más información</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── Precios ── -->
  <section aria-labelledby="precios-heading" class="bg-surface">
    <div class="container-b8 section-py">
      <div class="max-w-2xl mx-auto">
        <div class="text-center mb-10">
          <p class="eyebrow mb-4" aria-hidden="true">
            Tarifas
          </p>
          <h2 id="precios-heading" class="font-serif text-bark text-3xl sm:text-4xl font-medium leading-tight mb-4">
            Precios y forma de pago
          </h2>
          <p class="text-earth text-base leading-relaxed">
            Tarifas claras, sin permanencias ni compromisos de mínimos de sesiones.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-4 mb-8">
          <!-- Precio estándar -->
          <div class="bg-cream border-2 border-forest/25 rounded-2xl p-6 text-center">
            <p class="eyebrow mb-2">Sesión individual</p>
            <p class="font-serif text-bark text-4xl font-medium mb-1">{SITE.priceSesion} <span class="text-2xl">€</span></p>
            <p class="text-clay text-sm">por sesión · 50–60 min</p>
            <ul class="mt-4 text-left space-y-2">
              {['Terapia individual', 'Terapia infanto-juvenil', 'Terapia online', 'Neurodivergencia', 'Orientación familiar'].map((item) => (
                <li class="flex items-center gap-2 text-earth text-sm">
                  <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="#3F5A45" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="2 6 5 9 10 3"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Precio familiar -->
          <div class="bg-cream border border-sand rounded-2xl p-6 text-center">
            <p class="eyebrow mb-2">Sesión familiar</p>
            <p class="font-serif text-bark text-4xl font-medium mb-1">{SITE.priceFamiliar} <span class="text-2xl">€</span></p>
            <p class="text-clay text-sm">por sesión · 50–60 min</p>
            <ul class="mt-4 text-left space-y-2">
              <li class="flex items-center gap-2 text-earth text-sm">
                <svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="#3F5A45" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="2 6 5 9 10 3"/>
                </svg>
                Terapia familiar
              </li>
            </ul>
          </div>
        </div>

        <!-- Formas de pago -->
        <div class="bg-cream border border-sand rounded-2xl p-5">
          <h3 class="font-serif text-bark font-medium text-base mb-3">Formas de pago</h3>
          <div class="flex flex-wrap gap-3">
            {['Bizum', 'Transferencia bancaria', 'Efectivo (presencial)'].map((modo) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-surface border border-sand rounded-full text-earth text-sm font-sans">
                <svg width="13" height="13" viewBox="0 0 12 12" fill="none" stroke="#3F5A45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="2 6 5 9 10 3"/>
                </svg>
                {modo}
              </span>
            ))}
          </div>
        </div>

        <!-- Cancelación -->
        <div class="mt-4 p-4 bg-amber-50 border border-amber-200 rounded-xl">
          <p class="text-amber-900 text-sm font-sans leading-relaxed">
            <strong>Política de cancelación:</strong> Puedes cancelar o modificar tu sesión sin coste siempre que avises con al menos 24 horas de antelación. Las sesiones no canceladas dentro de ese plazo se consideran realizadas y deben abonarse.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- ── CTA ── -->
  <CTAFinal />

</Layout>
